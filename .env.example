APP_NAME="NDS - Nusantara Digital Solution"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# SMTP Gmail kantor NDS (email reset password & notifikasi).
# Gunakan App Password Gmail (BUKAN password akun), 16 karakter tanpa spasi:
# akun Google > Security > 2-Step Verification > App passwords.
# Jangan pernah menuliskan kredensial asli di source code — hanya .env,
# dan pastikan .env tidak ikut repository.
# Jika kredensial pernah terekspos, cabut App Password lama dan buat yang baru.
# -----------------------------------------------------------------------------
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=ndsmanagement333@gmail.com
# MAIL_PASSWORD=<APP_PASSWORD_16_KARAKTER>
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=ndsmanagement333@gmail.com
# MAIL_FROM_NAME="Nusantara Digital Solution"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Production security note:
# - Set APP_DEBUG=false di produksi.
# - APP_KEY harus berisi 32-characeter random string (php artisan key:generate).
# -----------------------------------------------------------------------------

# Admin seeding password (diperlukan oleh php artisan db:seed)
ADMIN_PASSWORD=

APP_PREVIOUS_KEYS=

# -----------------------------------------------------------------------------
# Reverb (broadcasting / real-time WebSocket)
# Kuncil VITE_* di bawah harus sama nilainya dengan pasangan REVERB_* di
# atas — frontend (resources/js/echo.ts) membaca via import.meta.env.
# -----------------------------------------------------------------------------
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# -----------------------------------------------------------------------------
# Tawk.to integration
# - Property ID: ID properti chat widget Anda
# - Secret Key: API secret key (dipakai untuk API polling)
# - Webhook Secret: secret untuk verifikasi signature webhook HMAC-SHA1
# -----------------------------------------------------------------------------
TAWK_PROPERTY_ID=
TAWK_SECRET_KEY=
TAWK_WEBHOOK_SECRET=
